<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_membership_channel_sync" model="ir.ui.view">
        <field name="name">res.config.settings.membership.channel.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Membership Channel Sync" string="Membership Channel Sync">
                    <h2>Membership channel sync</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="delegate_tag_id"/>
                                <div class="text-muted">Tag that means “Delegate”.</div>
                                <field name="delegate_tag_id"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="member_tag_id"/>
                                <div class="text-muted">Tag that means “Member”.</div>
                                <field name="member_tag_id"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="delegate_channel_id"/>
                                <div class="text-muted">Discuss channel for Delegates.</div>
                                <field name="delegate_channel_id"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="member_channel_id"/>
                                <div class="text-muted">Discuss channel for Members.</div>
                                <field name="member_channel_id"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="general_secretary_partner_id"/>
                                <div class="text-muted">Always included in mapped channels.</div>
                                <field name="general_secretary_partner_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
