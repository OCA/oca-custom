<odoo>

    <!-- Kanban -->
    <record id="mail_group_view_kanban" model="ir.ui.view">
        <field name="name">mail.group.view.kanban.oca_membership</field>
        <field name="model">mail.group</field>
        <field name="inherit_id" ref="mail_group.mail_group_view_kanban" />

        <field name="arch" type="xml">
            <field name="description" position="before">
                <div class="flex" invisible="not is_working_group">
                    <span class="o_badge badge rounded-pill o_tag o_tag_color_4">Working Group</span>
                </div>
            </field>
        </field>
    </record>
    <!-- List -->
    <record id="mail_group_view_list" model="ir.ui.view">
        <field name="name">mail.group.view.list.oca_membership</field>
        <field name="model">mail.group</field>
        <field name="inherit_id" ref="mail_group.mail_group_view_list" />

        <field name="arch" type="xml">
            <field name="moderation" position="after">
                <field name="is_working_group" />
            </field>
        </field>
    </record>
    <!-- Form -->
    <record id="mail_group_view_form" model="ir.ui.view">
        <field name="name">mail.group.view.form.oca_membership</field>
        <field name="model">mail.group</field>
        <field name="inherit_id" ref="mail_group.mail_group_view_form" />
        
        <field name="arch" type="xml">
            <field name="moderation" position="after">
                <field name="is_working_group" widget="boolean_toggle" />
            </field>
        </field>
    </record>
    <!-- Search -->
    <record id="mail_group_view_search" model="ir.ui.view">
        <field name="name">mail.group.view.search.oca_membership</field>
        <field name="model">mail.group</field>
        <field name="inherit_id" ref="mail_group.mail_group_view_search" />
        
        <field name="arch" type="xml">
            <filter name="moderation" position="after">
                <filter string="Working Groups" name="is_working_group" domain="[('is_working_group', '=', True)]" />
            </filter>
        </field>
    </record>

    <!-- New entry menu 'Working Groups' in Membership app -->
    <record id="mail_group_action_working_groups" model="ir.actions.act_window">
        <field name="name">Working Groups</field>
        <field name="res_model">mail.group</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'default_is_working_group': True,
            'search_default_is_working_group': True,
        }</field>
    </record>
    <menuitem
        id="menu_membership_mail_group"
        sequence="30"
        parent="membership.menu_association"
        action="oca_membership.mail_group_action_working_groups"
    />

</odoo>
