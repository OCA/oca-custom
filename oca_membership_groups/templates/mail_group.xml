<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="group_messages_robots"
        inherit_id="mail_group.group_messages"
        name="Mail Groups - Robots noindex"
    >
        <xpath expr="//t[@t-call='portal.portal_layout']" position="before">
            <t t-set="head">
                <t t-out="head" />
                <meta name="robots" content="noindex" />
            </t>
        </xpath>
    </template>
    <template
        id="group_message_robots"
        inherit_id="mail_group.group_message"
        name="Mail Groups Message - Robots noindex"
    >
        <xpath expr="//t[@t-call='portal.portal_layout']" position="before">
            <t t-set="head">
                <t t-out="head" />
                <meta name="robots" content="noindex, nofollow" />
            </t>
        </xpath>
    </template>
    <!-- Port of OCB fix "[FIX] mail_group: 405 Method not allowed in
         mail_footer": the native footer uses "unsub_url" as link target,
         which points to the RFC 8058 one-click unsubscribe route. That
         route only accepts POST, so following the link from a mail client
         returns a 405. Use the GET-friendly unsubscribe page URL carried
         by "unsub_label" instead, as fixed natively. -->
    <template
        id="mail_group_footer_unsubscribe_url"
        inherit_id="mail_group.mail_group_footer"
        name="Mail Group Footer - GET Unsubscribe URL"
    >
        <xpath expr="//a[@t-att-href='unsub_url']" position="attributes">
            <attribute name="t-att-href">unsub_label</attribute>
        </xpath>
    </template>
</odoo>
