<data>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="OCA subscription" string="OCA subscription" data-key="oca_monetize">
                    <div id="oca_subscription">
                        <h2>OCA subscription</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <div class="mt16 row">
                                            <label for="oca_monetize_name" class="col-3 col-lg-3 o_light_label"/>
                                            <field name="oca_monetize_name" class="oe_inline" />
                                        </div>
                                        <div class="mt16 row">
                                            <label for="oca_monetize_key" class="col-3 col-lg-3 o_light_label"/>
                                            <field name="oca_monetize_key" class="oe_inline" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</data>
